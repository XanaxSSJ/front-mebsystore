// MebsyStore — PostgreSQL (Supabase) schema aligned with legacy Flyway migrations

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id        String   @id @default(uuid()) @db.Uuid
  email     String   @unique @db.VarChar(150)
  password  String   @db.VarChar(255)
  role      String   @db.VarChar(50) // USER | ADMIN (legacy column, not PG enum)
  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")

  profile UserProfile?
  addresses Address[]
  orders  Order[]

  @@map("users")
}

model UserProfile {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @unique @map("user_id") @db.Uuid
  firstName String?  @map("first_name") @db.VarChar(100)
  lastName  String?  @map("last_name") @db.VarChar(100)
  phone     String?  @db.VarChar(20)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_profiles")
}

model Address {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String   @map("user_id") @db.Uuid
  street     String   @db.VarChar(255)
  department String   @db.VarChar(100)
  province   String   @db.VarChar(100)
  district   String   @db.VarChar(100)
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("addresses")
}

model Ubigeo {
  id         Int     @id @default(autoincrement())
  department String  @db.VarChar(100)
  province   String  @db.VarChar(100)
  district   String  @db.VarChar(100)
  ubigeoCode String? @unique @map("ubigeo_code") @db.VarChar(6)

  @@unique([department, province, district], name: "uk_ubigeo_complete")
  @@index([department, province, district])
  @@map("ubigeo")
}

model Category {
  id        String   @id @default(uuid()) @db.Uuid
  name      String   @db.VarChar(255)
  slug      String   @unique @db.VarChar(100)
  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")

  products Product[]

  @@index([slug])
  @@index([active])
  @@map("categories")
}

model Brand {
  id        String   @id @default(uuid()) @db.Uuid
  name      String   @unique @db.VarChar(255)
  slug      String   @unique @db.VarChar(100)
  logoUrl   String?  @map("logo_url") @db.VarChar(500)
  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")

  products Product[]

  @@index([active])
  @@map("brands")
}

model Product {
  id          String    @id @default(uuid()) @db.Uuid
  name        String    @db.VarChar(255)
  description String?   @db.Text
  slug        String    @unique @db.VarChar(150)
  brandId     String    @map("brand_id") @db.Uuid
  categoryId  String    @map("category_id") @db.Uuid
  basePrice   Decimal?  @map("base_price") @db.Decimal(19, 2)
  active      Boolean   @default(true)
  createdAt   DateTime  @default(now()) @map("created_at")

  brand    Brand    @relation(fields: [brandId], references: [id])
  category Category @relation(fields: [categoryId], references: [id])

  attributes ProductAttribute[]
  variants   ProductVariant[]
  images     ProductImage[]
  orderItems OrderItem[]

  @@index([categoryId])
  @@index([brandId])
  @@index([active])
  @@map("products")
}

model ProductAttribute {
  id          String   @id @default(uuid()) @db.Uuid
  productId   String   @map("product_id") @db.Uuid
  name        String   @db.VarChar(255)
  displayName String   @map("display_name") @db.VarChar(255)
  createdAt   DateTime @default(now()) @map("created_at")

  product Product                 @relation(fields: [productId], references: [id], onDelete: Cascade)
  values  ProductAttributeValue[]

  @@unique([productId, name], name: "uq_product_attributes_product_name")
  @@map("product_attributes")
}

model ProductAttributeValue {
  id          String @id @default(uuid()) @db.Uuid
  attributeId String @map("attribute_id") @db.Uuid
  value       String @db.VarChar(255)

  attribute            ProductAttribute      @relation(fields: [attributeId], references: [id], onDelete: Cascade)
  variantLinks         VariantAttributeValue[]

  @@unique([attributeId, value], name: "uq_attr_values_attribute_value")
  @@map("product_attribute_values")
}

model ProductVariant {
  id        String    @id @default(uuid()) @db.Uuid
  productId String    @map("product_id") @db.Uuid
  sku       String    @unique @db.VarChar(255)
  price     Decimal?  @db.Decimal(19, 2)
  stock     Int
  active    Boolean   @default(true)

  product          Product                 @relation(fields: [productId], references: [id], onDelete: Cascade)
  attributeLinks   VariantAttributeValue[]
  images           ProductImage[]
  orderItems       OrderItem[]

  @@index([productId])
  @@index([sku])
  @@index([productId, active])
  @@map("product_variants")
}

model VariantAttributeValue {
  variantId        String @map("variant_id") @db.Uuid
  attributeValueId String @map("attribute_value_id") @db.Uuid

  variant        ProductVariant        @relation(fields: [variantId], references: [id], onDelete: Cascade)
  attributeValue ProductAttributeValue @relation(fields: [attributeValueId], references: [id], onDelete: Restrict)

  @@id([variantId, attributeValueId])
  @@index([attributeValueId])
  @@map("variant_attribute_values")
}

model ProductImage {
  id        String  @id @default(uuid()) @db.Uuid
  productId String  @map("product_id") @db.Uuid
  variantId String? @map("variant_id") @db.Uuid
  imageUrl  String  @map("image_url") @db.VarChar(500)
  sortOrder Int     @default(0) @map("sort_order")

  product Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant ProductVariant? @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@index([variantId])
  @@map("product_images")
}

model Order {
  id                String    @id @default(uuid()) @db.Uuid
  userId            String    @map("user_id") @db.Uuid
  total             Decimal   @db.Decimal(19, 2)
  status            String    @db.VarChar(50)
  shippingStreet    String?   @map("shipping_street") @db.VarChar(255)
  shippingDepartment String?  @map("shipping_department") @db.VarChar(100)
  shippingProvince  String?   @map("shipping_province") @db.VarChar(100)
  shippingDistrict  String?   @map("shipping_district") @db.VarChar(100)
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")
  expiresAt         DateTime? @map("expires_at")

  user  User        @relation(fields: [userId], references: [id])
  items OrderItem[]

  @@index([userId])
  @@index([status])
  @@index([createdAt])
  @@map("orders")
}

model OrderItem {
  id          String  @id @default(uuid()) @db.Uuid
  orderId     String  @map("order_id") @db.Uuid
  productId   String  @map("product_id") @db.Uuid
  variantId   String  @map("variant_id") @db.Uuid
  productName String  @map("product_name") @db.VarChar(255)
  quantity    Int
  unitPrice   Decimal @map("unit_price") @db.Decimal(19, 2)
  subtotal    Decimal @db.Decimal(19, 2)

  order   Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product        @relation(fields: [productId], references: [id])
  variant ProductVariant @relation(fields: [variantId], references: [id])

  @@index([orderId])
  @@index([productId])
  @@index([variantId])
  @@map("order_items")
}
